<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Solo para el aviso de la bandeja (NotifyIcon) de la limpieza programada -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RnxCleaner</RootNamespace>
    <AssemblyName>RNX_Cache_Cleaner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\rnx.ico</ApplicationIcon>

    <!-- Version unica del programa: la lee tambien el workflow de release -->
    <Version>5.3.4</Version>
    <Product>RNX Cache Cleaner Pro</Product>
    <Company>RNX Systems</Company>
    <Copyright>Ren0X1</Copyright>

    <!-- Publicacion: un unico .exe autocontenido (no hace falta instalar .NET) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
  </PropertyGroup>


  <!-- Herramientas y perfiles que viajan DENTRO del .exe y se extraen
       a %LOCALAPPDATA%\RNX Cache Cleaner\tools al usarlos -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\nvidiaProfileInspector.exe" LogicalName="tools.nvidiaProfileInspector.exe" />
    <EmbeddedResource Include="Assets\RNX_Performance.nip" LogicalName="tools.RNX_Performance.nip" />
    <EmbeddedResource Include="Assets\RNX_Performance.pow" LogicalName="tools.RNX_Performance.pow" />
    <EmbeddedResource Include="Assets\RNX_Performance.power.json" LogicalName="power.RNX_Performance.json" />
    <EmbeddedResource Include="Assets\raton.reg" LogicalName="tools.raton.reg" />
    <EmbeddedResource Include="Assets\logo.bmp" LogicalName="oem.logo.bmp" />
    <EmbeddedResource Include="Assets\fixStoreIssues.cmd" LogicalName="tools.fixStoreIssues.cmd" />
    <!-- 7-Zip de consola (7zr, dominio publico) para descomprimir el instalador de NVIDIA -->
    <EmbeddedResource Include="Assets\7zr.exe" LogicalName="tools.7zr.exe" />
    <!-- Tipos de inicio de servicios para el ajuste "Servicios" (pestana Windows) -->
    <EmbeddedResource Include="Assets\tweaks\services.txt" LogicalName="tweaks.services.txt" />
    <!-- Font Manager: Bebas Neue (SIL OFL 1.1) y plantilla de fonts.conf -->
    <EmbeddedResource Include="Assets\fonts\BebasNeue-Regular.ttf" LogicalName="fonts.BebasNeue-Regular.ttf" />
    <EmbeddedResource Include="Assets\fonts\fonts.conf.template" LogicalName="fonts.fonts.conf.template" />
    <!-- Config completa de CS2 de RNX (binds, sensibilidad, mira, opciones y video) -->
    <EmbeddedResource Include="Assets\cs2config\**\*" LogicalName="cs2cfg\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Cliente OAuth de Google (NO se sube al repo: lo genera el workflow
         desde un secret, o lo pones tu a mano para compilar en local) -->
    <EmbeddedResource Include="Assets\google_client.json" LogicalName="google_client.json" Condition="Exists('Assets\google_client.json')" />
    <!-- Secreto TOTP de activacion: no esta en el repo, lo mete el workflow desde un secret -->
    <EmbeddedResource Include="Assets\activation.secret" LogicalName="activation.secret" Condition="Exists('Assets\activation.secret')" />
    <Resource Include="Assets\rnx.ico" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.78.0.4327" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.2" />
    <PackageReference Include="System.Management" Version="11.0.0" />
  </ItemGroup>

</Project>
