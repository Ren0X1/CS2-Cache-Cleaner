                                <Canvas x:Name="HistChart" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" SizeChanged="HistChart_SizeChanged"/>
                                <TextBlock x:Name="HistEmpty" Grid.Row="1" Text="{c:L hist.empty}" Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="8,8">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="12,4,22,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{c:L hist.col.date}" Style="{StaticResource Meta}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{c:L hist.col.mode}" Style="{StaticResource Meta}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{c:L hist.col.freed}" Style="{StaticResource Meta}" FontSize="12" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{c:L hist.col.time}" Style="{StaticResource Meta}" FontSize="12" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{c:L hist.col.result}" Style="{StaticResource Meta}" FontSize="12" Margin="18,0,0,0"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="HistTable">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,7" BorderBrush="{DynamicResource Line2}" BorderThickness="0,1,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Date}" Foreground="{DynamicResource Muted}" FontSize="13"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Mode}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Freed}" FontSize="13" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Time}" Foreground="{DynamicResource Muted}" FontSize="13" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Result}" Foreground="{Binding ResultBrush}" FontSize="13" Margin="18,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ======== REGISTRO ======== -->
                    <Grid x:Name="PageLog" Visibility="Collapsed" Margin="36,34,36,28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="LogRefresh_Click" Content="{c:L log.refresh}"/>
                                <Button Style="{StaticResource GhostButton}" Click="OpenDataFolder_Click" Content="{c:L log.folder}"/>
                            </StackPanel>
                            <StackPanel><TextBlock Text="{c:L log.title}" Style="{StaticResource H1}"/><TextBlock Style="{StaticResource Sub}" FontSize="14.5" Margin="0,4,0,0" Text="{c:L log.sub}"/></StackPanel>
                        </DockPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                            <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource Mono}" FontSize="12"
                                     Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                        </Border>
                    </Grid>

                    <!-- ======== PROGRESO ======== -->
                    <Grid x:Name="PageRun" Visibility="Collapsed" Margin="36,34,36,28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="RunOverline" Text="-" Style="{StaticResource Overline}"/>
                            <DockPanel>
                                <TextBlock x:Name="RunPercent" DockPanel.Dock="Right" Text="0%" FontSize="30" FontWeight="Bold" FontFamily="{StaticResource Display}" Foreground="{DynamicResource Accent}"/>
                                <TextBlock x:Name="RunTitle" Text="-" Style="{StaticResource H1}"/>
                            </DockPanel>
                            <ProgressBar x:Name="RunBar" Margin="0,12,0,20" Maximum="1"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="6">
                                <ScrollViewer x:Name="StepsScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="StepsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="row" Padding="12,8" CornerRadius="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="13.5"/>
                                                            <ProgressBar Value="{Binding Progress}" Maximum="1" Margin="0,6,0,2">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource ThinBar}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding HasProgress}" Value="True"/>
                                                                                    <Condition Binding="{Binding IsRunning}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Detail}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource Tint}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="6">
                                <ScrollViewer x:Name="LiveScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LiveLog" Margin="10,8" FontFamily="{StaticResource Mono}" FontSize="12"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="KeepOpenBtn" Style="{StaticResource GhostButton}" Content="{c:L run.keepOpen}" Margin="0,0,8,0" Click="KeepOpen_Click" Visibility="Collapsed"/>
                                    <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}" Content="{c:L run.cancel}" Click="Cancel_Click"/>
                                    <Button x:Name="DoneBtn" Style="{StaticResource PrimaryButton}" Content="{c:L run.back}" Click="Done_Click" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Margin="0,0,36,0"><TextBlock Text="{c:L run.freed}" Style="{StaticResource Meta}" FontSize="12"/><TextBlock x:Name="RunFreed" Text="-" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Accent}"/></StackPanel>
                                    <StackPanel Margin="0,0,36,0"><TextBlock Text="{c:L run.time}" Style="{StaticResource Meta}" FontSize="12"/><TextBlock x:Name="RunTime" Text="00:00" FontSize="20" FontWeight="Bold"/></StackPanel>
                                    <StackPanel><TextBlock Text="{c:L run.state}" Style="{StaticResource Meta}" FontSize="12"/><TextBlock x:Name="RunState" Text="-" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Botones de ventana -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0" WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="20">
                        <Button Content="&#xE921;" Style="{StaticResource ChromeButton}" Click="Min_Click"/>
                        <Button x:Name="MaxBtn" Content="&#xE922;" Style="{StaticResource ChromeButton}" Click="Max_Click"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="Close_Click"/>
                    </StackPanel>

                    <!-- Aviso de actualizacion -->
                    <Border x:Name="UpdateBanner" Width="420" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,24,0" Padding="20,16" Visibility="Collapsed" Panel.ZIndex="15"
                            Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="{c:L upd.label}" Style="{StaticResource Overline}" Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="UpdateTitle" Text="-" Style="{StaticResource H2}" FontSize="16"/>
                            <TextBlock x:Name="UpdateSub" Style="{StaticResource Sub}" Margin="0,4,0,10" Text="-"/>
                            <StackPanel x:Name="UpdateNotesBox" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="{c:L upd.whatsnew}" Style="{StaticResource Meta}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="UpdateNotesText" FontSize="13" LineHeight="20" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" Text=""/>
                                </ScrollViewer>
                            </StackPanel>
                            <ProgressBar x:Name="UpdateBar" Style="{StaticResource ThinBar}" Maximum="1" Margin="0,0,0,10" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="UpdateNotesBtn" Style="{StaticResource GhostButton}" Content="{c:L upd.notes}" Margin="0,0,8,0" Click="UpdateNotes_Click"/>
                                <Button x:Name="UpdateLaterBtn" Style="{StaticResource GhostButton}" Content="{c:L upd.later}" Margin="0,0,8,0" Click="UpdateLater_Click"/>
                                <Button x:Name="UpdateNowBtn" Style="{StaticResource PrimaryButton}" Content="{c:L upd.now}" Click="UpdateNow_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Toast -->
                    <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Padding="18,10" Panel.ZIndex="16"
                            Background="{DynamicResource Ink}" CornerRadius="10" Opacity="0" IsHitTestVisible="False">
                        <TextBlock x:Name="ToastText" Text="" FontSize="13" Foreground="{DynamicResource Sheet}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ======== DIALOGO ======== -->
            <Grid x:Name="Dialog" Grid.ColumnSpan="2" Background="{DynamicResource Shade}" Visibility="Collapsed" Panel.ZIndex="30">
                <Border Width="540" VerticalAlignment="Center" Padding="28,24" Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="14">
                    <StackPanel>
                        <TextBlock x:Name="DialogOverline" Text="-" Style="{StaticResource Overline}" Foreground="{DynamicResource Warn}"/>
                        <TextBlock x:Name="DialogTitle" Text="-" Style="{StaticResource H2}" FontSize="19" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DialogText" Text="-" Style="{StaticResource Sub}" Margin="0,10,0,22"/>
                        <Border x:Name="DialogListBox" Visibility="Collapsed" Margin="0,-8,0,22" Padding="12,8" CornerRadius="8" Background="{DynamicResource Track}">
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="DialogList" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource Ink}"/>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DialogNo" Style="{StaticResource GhostButton}" Content="-" Margin="0,0,8,0" Click="DialogNo_Click"/>
                            <Button x:Name="DialogYes" Style="{StaticResource PrimaryButton}" Content="-" Click="DialogYes_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======== PRIMER ARRANQUE: idioma, color y apariencia ======== -->
            <Grid x:Name="FirstRun" Grid.ColumnSpan="2" Background="{DynamicResource Frame}" Visibility="Collapsed" Panel.ZIndex="40">
                <Border Width="640" VerticalAlignment="Center" Padding="36,32,36,30" Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="16" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Path DockPanel.Dock="Left" Data="{StaticResource LogoGeometry}" Fill="{DynamicResource Accent}" Stretch="Uniform" Width="44" Height="44" Margin="0,2,18,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock x:Name="FrTitle" Text="-" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="FrSub" Text="-" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="FrLangLbl" Text="-" FontWeight="Bold" FontSize="13" Margin="0,20,0,8"/>
                        <UniformGrid x:Name="FrLangs" Columns="2"/>
                        <TextBlock Margin="0,20,0,8" FontSize="13"><Run x:Name="FrColorLbl" Text="-" FontWeight="Bold"/><Run Text="  "/><Run x:Name="FrColorName" Text="-" Foreground="{DynamicResource Muted}"/></TextBlock>
                        <StackPanel x:Name="FrColors" Orientation="Horizontal"/>
                        <TextBlock x:Name="FrLookLbl" Text="-" FontWeight="Bold" FontSize="13" Margin="0,20,0,8"/>
                        <Border Style="{StaticResource SegBox}">
                            <UniformGrid x:Name="FrLooks" Columns="3"/>
                        </Border>
                        <Button x:Name="FrContinue" Style="{StaticResource PrimaryButton}" Content="-" Height="46" Margin="0,26,0,0" HorizontalContentAlignment="Center" Click="FirstRunContinue_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
