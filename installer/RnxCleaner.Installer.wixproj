<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Instalador MSI de RNX Cache Cleaner Pro (WiX Toolset 5).
    Compilar (despues de publicar el .exe en ..\dist):
      dotnet build installer\RnxCleaner.Installer.wixproj -c Release -p:Version=5.0.0
    Sale en ..\dist\RNX_Cache_Cleaner_<version>.msi
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">5.0.0</Version>
    <OutputName>RNX_Cache_Cleaner_$(Version)</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <PublishDir>$(MSBuildThisFileDirectory)..\dist\</PublishDir>
    <DefineConstants>Version=$(Version);PublishDir=$(PublishDir);AssetsDir=$(MSBuildThisFileDirectory)..\src\RnxCleaner\Assets\</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\dist\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</IntermediateOutputPath>
    <SuppressPdbOutput>true</SuppressPdbOutput>
    <Cultures>es-ES</Cultures>
  </PropertyGroup>
</Project>
