<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RnxCleaner</RootNamespace>
    <AssemblyName>RNX_Cache_Cleaner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\rnx.ico</ApplicationIcon>

    <!-- Version unica del programa: la lee tambien el workflow de release -->
    <Version>5.0.0</Version>
    <Product>RNX Cache Cleaner Pro</Product>
    <Company>RNX Systems</Company>
    <Copyright>Ren0X1</Copyright>

    <!-- Publicacion: un unico .exe autocontenido (no hace falta instalar .NET) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
  </PropertyGroup>


  <!-- Herramientas y perfiles que viajan DENTRO del .exe y se extraen
       a %LOCALAPPDATA%\RNX Cache Cleaner\tools al usarlos -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\nvidiaProfileInspector.exe" LogicalName="tools.nvidiaProfileInspector.exe" />
    <EmbeddedResource Include="Assets\CS2.nip" LogicalName="tools.CS2.nip" />
    <EmbeddedResource Include="Assets\raton.reg" LogicalName="tools.raton.reg" />
    <!-- Cliente OAuth de Google (NO se sube al repo: lo genera el workflow
         desde un secret, o lo pones tu a mano para compilar en local) -->
    <EmbeddedResource Include="Assets\google_client.json" LogicalName="google_client.json" Condition="Exists('Assets\google_client.json')" />
    <Resource Include="Assets\rnx.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.78.0.4327" />
    <PackageReference Include="System.Management" Version="11.0.0" />
  </ItemGroup>

</Project>
