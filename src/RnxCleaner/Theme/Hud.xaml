<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         TEMA HUD  -  Head-Up Display de caza (F/A-18 Super Hornet)
         Monocromo verde fosforo sobre negro, lineas finas, esquinas en
         escuadra. Ambar = precaucion, rojo = fallo. Nada mas de color.
         ===================================================================== -->
    <Color x:Key="HudColor">#5FD68A</Color>
    <Color x:Key="BgColor">#070A09</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Panel" Color="#0A0F0D"/>
    <SolidColorBrush x:Key="Card" Color="#0C1210"/>
    <SolidColorBrush x:Key="CardHover" Color="#111B16"/>
    <SolidColorBrush x:Key="Line" Color="#1D2B24"/>
    <SolidColorBrush x:Key="LineBright" Color="#2F5240"/>
    <SolidColorBrush x:Key="Hud" Color="{StaticResource HudColor}"/>
    <SolidColorBrush x:Key="Text" Color="#DCE4DF"/>
    <SolidColorBrush x:Key="Muted" Color="#8C9A92"/>
    <SolidColorBrush x:Key="Faint" Color="#56655D"/>
    <SolidColorBrush x:Key="Ok" Color="{StaticResource HudColor}"/>
    <SolidColorBrush x:Key="Amber" Color="#E8A33D"/>
    <SolidColorBrush x:Key="Red" Color="#E5534B"/>
    <SolidColorBrush x:Key="HudFill" Color="#105FD68A"/>
    <SolidColorBrush x:Key="HudFillStrong" Color="#205FD68A"/>

    <!-- Logo RNX (vector, caja 1000x1000) extraido de logo.ai -->
    <PathGeometry x:Key="LogoGeometry" FillRule="Nonzero" Figures="M 109.9,268.6 C 67.2,252.9 47.8,216.0 29.5,178.0 43.0,247.1 61.3,313.6 121.5,360.0 L 81.4,339.7 C 88.1,352.2 96.0,363.5 105.3,373.6 139.7,410.7 182.6,435.8 226.5,460.0 258.7,477.8 288.9,499.2 320.1,518.7 328.7,524.0 331.1,531.1 331.1,541.1 330.7,634.9 330.6,728.7 330.9,822.5 331.2,897.2 376.8,962.1 446.7,986.0 464.6,992.2 483.9,994.2 505.4,998.8 V 716.3 C 507.7,715.6 507.7,715.6 509.9,714.9 512.8,718.8 515.3,723.2 518.7,726.6 590.5,798.1 662.5,869.2 734.1,941.0 775.3,982.3 824.5,1000.0 882.2,992.9 920.3,988.2 953.0,971.9 981.9,943.1 895.0,856.0 809.1,769.9 722.8,683.4 726.8,681.9 731.3,680.2 735.8,678.6 845.7,638.7 911.0,525.7 890.8,410.2 871.3,298.9 771.4,215.8 656.3,215.3 610.4,215.1 564.5,215.3 518.5,215.3 514.4,215.3 510.3,215.9 504.0,216.4 548.1,267.3 579.2,322.1 589.3,388.0 597.8,388.0 605.3,388.0 612.7,388.0 617.5,388.0 622.3,388.0 627.0,387.9 637.7,387.8 648.4,387.7 659.1,388.2 694.5,389.6 721.5,418.4 721.2,453.9 720.9,488.5 693.7,517.0 659.0,517.9 632.1,518.7 605.2,518.1 577.9,518.1 557.1,585.4 523.9,645.3 482.6,701.1 508.6,631.3 529.6,560.5 530.9,484.4 533.9,493.2 522.3,388.6 519.4,385.4 506.1,338.6 491.5,330.1 461.9,299.8 461.9,299.8 461.9,299.7 461.9,299.7 423.7,260.1 376.8,233.9 327.0,212.7 277.9,191.8 227.4,174.3 178.7,152.5 151.7,140.5 125.6,124.8 101.9,107.1 70.7,83.8 61.6,50.2 68.5,12.2 69.1,8.7 69.7,5.3 70.6,0.0 18.1,57.7 32.9,200.8 109.9,268.6"/>

    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Display">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

    <DropShadowEffect x:Key="Glow" Color="#5FD68A" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
    <DropShadowEffect x:Key="GlowSoft" Color="#5FD68A" BlurRadius="8" ShadowDepth="0" Opacity="0.18"/>
    <DropShadowEffect x:Key="GlowAmber" Color="#E8A33D" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>

    <!-- Lineas de barrido tipo pantalla de fosforo -->
    <DrawingBrush x:Key="Scanlines" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Opacity="0.025">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#5FD68A">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,4,1"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Rejilla tenue de fondo -->
    <DrawingBrush x:Key="Grid" TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute" Opacity="0.03">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen><Pen Brush="#5FD68A" Thickness="1"/></GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="48,0"/>
                        <LineGeometry StartPoint="0,0" EndPoint="0,48"/>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ============ Texto ============ -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Data" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============ Panel con esquinas en escuadra (el "marco" del HUD) ============ -->
    <Style x:Key="HudPanel" TargetType="ContentControl">
        <Setter Property="Padding" Value="20,18"/>
        <Setter Property="Background" Value="#C00A0F0D"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Line}" BorderThickness="1"/>
                        <!-- escuadras en las 4 esquinas -->
                        <Path Data="M0,12 L0,0 L12,0" Stroke="{StaticResource Hud}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Path Data="M0,0 L12,0 L12,12" Stroke="{StaticResource Hud}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Path Data="M0,0 L0,12 L12,12" Stroke="{StaticResource Hud}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <Path Data="M12,0 L12,12 L0,12" Stroke="{StaticResource Hud}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Botones ============ -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Hud}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Boton principal: relleno verde, texto negro -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="#0A0F0D"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{StaticResource Hud}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Effect" Value="{StaticResource Glow}"/>
                            <Setter TargetName="b" Property="Background" Value="#7FE3A3"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boton secundario: solo contorno -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource LineBright}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Hud}"/>
                            <Setter TargetName="b" Property="Background" Value="{StaticResource HudFill}"/>
                            <Setter TargetName="b" Property="Effect" Value="{StaticResource GlowSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enlace de texto (barra inferior) -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="t" Text="{TemplateBinding Content}" Background="Transparent"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource Hud}"/>
                            <Setter TargetName="t" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="t" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource HudFill}"/>
                            <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#33FF3B3B"/>
                            <Setter Property="Foreground" Value="{StaticResource Red}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estacion de armamento (tarjetas de modo RAPIDA / COMPLETA / TODO) -->
    <Style x:Key="StationButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="20,18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" Background="#C00A0F0D">
                        <Border x:Name="frame" BorderBrush="{StaticResource Line}" BorderThickness="1"/>
                        <Path x:Name="c1" Data="M0,16 L0,0 L16,0" Stroke="{StaticResource LineBright}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Path x:Name="c2" Data="M0,0 L16,0 L16,16" Stroke="{StaticResource LineBright}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Path x:Name="c3" Data="M0,0 L0,16 L16,16" Stroke="{StaticResource LineBright}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <Path x:Name="c4" Data="M16,0 L16,16 L0,16" Stroke="{StaticResource LineBright}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource HudFill}"/>
                            <Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource LineBright}"/>
                            <Setter TargetName="c1" Property="Stroke" Value="{StaticResource Hud}"/>
                            <Setter TargetName="c2" Property="Stroke" Value="{StaticResource Hud}"/>
                            <Setter TargetName="c3" Property="Stroke" Value="{StaticResource Hud}"/>
                            <Setter TargetName="c4" Property="Stroke" Value="{StaticResource Hud}"/>
                            <Setter TargetName="c1" Property="Effect" Value="{StaticResource Glow}"/>
                            <Setter TargetName="c2" Property="Effect" Value="{StaticResource Glow}"/>
                            <Setter TargetName="c3" Property="Effect" Value="{StaticResource Glow}"/>
                            <Setter TargetName="c4" Property="Effect" Value="{StaticResource Glow}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource HudFillStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Navegacion lateral ============ -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"/>
                        <StackPanel Orientation="Horizontal" Margin="12,10">
                            <TextBlock x:Name="caret" Text="&#x25B6;" FontSize="9" Width="16" VerticalAlignment="Center" Opacity="0"/>
                            <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                            <Setter TargetName="bg" Property="Background" Value="#085FD68A"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource HudFill}"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource LineBright}"/>
                            <Setter TargetName="caret" Property="Opacity" Value="1"/>
                            <Setter TargetName="ic" Property="Effect" Value="{StaticResource GlowSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Interruptor estilo MASTER ARM (SAFE / ARM) ============ -->
    <Style x:Key="ArmSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <Border Grid.Column="1" BorderBrush="{StaticResource LineBright}" BorderThickness="1" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="safe" Width="48" Height="24" Background="{StaticResource HudFillStrong}">
                                    <TextBlock x:Name="safeTxt" Text="OFF" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Hud}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="arm" Width="48" Height="24" Background="Transparent">
                                    <TextBlock x:Name="armTxt" Text="ON" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="safe" Property="Background" Value="Transparent"/>
                            <Setter TargetName="safeTxt" Property="Foreground" Value="{StaticResource Faint}"/>
                            <Setter TargetName="arm" Property="Background" Value="{StaticResource Hud}"/>
                            <Setter TargetName="arm" Property="Effect" Value="{StaticResource Glow}"/>
                            <Setter TargetName="armTxt" Property="Foreground" Value="#0A0F0D"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Casilla de seleccion (limpieza personalizada) ============ -->
    <Style x:Key="CheckCard" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="b" Background="#C00A0F0D" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="16" Height="16" BorderBrush="{StaticResource LineBright}" BorderThickness="1" VerticalAlignment="Top" Margin="0,2,12,0">
                                <Rectangle x:Name="fill" Margin="3" Fill="{StaticResource Hud}" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource HudFill}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Hud}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Hud}"/>
                            <Setter TargetName="fill" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="fill" Property="Effect" Value="{StaticResource Glow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Barra de progreso (con marcas de escala) ============ -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" BorderBrush="{StaticResource Line}" BorderThickness="1"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource Hud}" Margin="2" Effect="{StaticResource GlowSoft}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ThinBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="#16241D"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource Hud}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Cajas de texto ============ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#060908"/>
        <Setter Property="Foreground" Value="{StaticResource Hud}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Hud}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Hud}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Hud}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Scrollbar fina ============ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource LineBright}" Margin="1"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="6"/>
                <Setter Property="MinHeight" Value="6"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource LineBright}" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#0A0F0D"/>
        <Setter Property="Foreground" Value="{StaticResource Hud}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBright}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
</ResourceDictionary>
