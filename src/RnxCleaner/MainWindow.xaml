<Window x:Class="RnxCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RnxCleaner"
        xmlns:c="clr-namespace:RnxCleaner.Core"
        Title="RNX Cache Cleaner"
        Width="1240" Height="800" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Frame}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource Ink}"
        Icon="Assets/rnx.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="{DynamicResource Frame}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= BARRA LATERAL ================= -->
            <Grid Margin="12,14,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,2,0,16">
                    <Path Data="{StaticResource LogoGeometry}" Fill="{DynamicResource Accent}" Stretch="Uniform" Width="26" Height="26" Margin="0,0,10,0"/>
                    <TextBlock Text="RNX Cache Cleaner" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource Scope}" CornerRadius="8" Padding="10,8" Margin="4,0,4,16">
                    <StackPanel>
                        <TextBlock x:Name="SysPc" Text="PC" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SysSpec" Text="Windows" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="2" Grid.RowSpan="2" VerticalScrollBarVisibility="Hidden" Focusable="False">
                <StackPanel x:Name="Nav" Margin="4,0">
                    <RadioButton x:Name="NavHome" Content="{c:L nav.home}" Tag="&#xE80F;" Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavCustom" Content="{c:L nav.custom}" Tag="&#xE9D5;" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"/>
                    <ToggleButton x:Name="NavCs2Group" Content="CS2" Tag="&#xE7FC;" Style="{StaticResource NavGroup}" Click="NavCs2Group_Click"/>
                    <StackPanel x:Name="NavCs2Items" Visibility="Collapsed">
                        <RadioButton x:Name="NavCs2" Content="{c:L nav.sub.modules}" Tag="&#xE74C;" Style="{StaticResource NavButton}" Margin="16,1,0,1" GroupName="nav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavVideo" Content="{c:L nav.sub.video}" Tag="&#xE7F4;" Style="{StaticResource NavButton}" Margin="16,1,0,1" GroupName="nav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavFonts" Content="{c:L nav.sub.fonts}" Tag="&#xE8D2;" Style="{StaticResource NavButton}" Margin="16,1,0,1" GroupName="nav" Checked="Nav_Checked"/>
                    </StackPanel>
                    <RadioButton x:Name="NavCustomRes" Content="{c:L nav.customres}" Tag="&#xE740;" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavVibrance" Content="{c:L nav.vibrance}" Tag="&#xE790;" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavHud" Content="HUD" Tag="&#xE9D9;" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"/>
                    <ToggleButton x:Name="NavDrvGroup" Tag="&#xE964;" Style="{StaticResource NavGroup}" Click="NavDrvGroup_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{c:L nav.drivers}"/>
                            <Border x:Name="DrvGroupBadge" Visibility="Collapsed" Background="{DynamicResource Accent}" CornerRadius="5" Padding="6,1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{c:L nvd.badge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}"/>
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel x:Name="NavDrvItems" Visibility="Collapsed">
                    <RadioButton x:Name="NavNvDriver" Tag="&#xE896;" Style="{StaticResource NavButton}" Margin="16,1,0,1" GroupName="nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{c:L nav.nvdriver}"/>
                            <Border x:Name="NvBadge" Visibility="Collapsed" Background="{DynamicResource Accent}" CornerRadius="5" Padding="6,1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{c:L nvd.badge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPcDrivers" Content="{c:L nav.pcdrivers}" Tag="&#xE7F8;" Style="{StaticResource NavButton}" Margin="16,1,0,1" GroupName="nav" Checked="Nav_Checked"/>
                    </StackPanel>
                    <ToggleButton x:Name="NavWinGroup" Content="Windows" Tag="&#xE770;" Style="{StaticResource NavGroup}" Click="NavWinGroup_Click"/>
                    <StackPanel x:Name="NavWinItems" Visibility="Collapsed">
                        <RadioButton x:Name="NavWinTweaks" Content="{c:L nav.win.tweaks}" Tag="&#xE9F5;" Style="{StaticResource NavButton}" Margin="16,1,0,1" GroupName="nav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavWinApps" Content="{c:L nav.win.apps}" Tag="&#xE71D;" Style="{StaticResource NavButton}" Margin="16,1,0,1" GroupName="nav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavWinStartup" Content="{c:L nav.win.startup}" Tag="&#xE7E8;" Style="{StaticResource NavButton}" Margin="16,1,0,1" GroupName="nav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavWinTasks" Content="{c:L nav.win.tasks}" Tag="&#xE823;" Style="{StaticResource NavButton}" Margin="16,1,0,1" GroupName="nav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavWinMods" Content="{c:L nav.win.mods}" Tag="&#xE90F;" Style="{StaticResource NavButton}" Margin="16,1,0,1" GroupName="nav" Checked="Nav_Checked"/>
                    </StackPanel>
                    <RadioButton x:Name="NavServers" Content="{c:L nav.servers}" Tag="&#xE909;" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavBackup" Content="{c:L nav.backup}" Tag="&#xE753;" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavHistory" Content="{c:L nav.history}" Tag="&#xE9D2;" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Content="{c:L nav.settings}" Tag="&#xE713;" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLog" Content="{c:L nav.log}" Tag="&#xE9F9;" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"/>
                </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="4" Margin="4,0">
                    <Button x:Name="CheckUpdatesBtn" Style="{StaticResource LinkButton}" Content="{c:L app.updates}" Click="CheckUpdates_Click" Margin="6,0,0,8" HorizontalAlignment="Left"/>
                    <DockPanel>
                        <TextBlock x:Name="VersionText" Text="v5.1" FontSize="12" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="LangBtn" Style="{StaticResource FootButton}" Click="LangBtn_Click" ToolTip="{c:L tip.lang}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Margin="0,0,6,0"/><TextBlock x:Name="LangCode" Text="EN" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="ColorBtn" Style="{StaticResource FootButton}" Click="ColorBtn_Click" ToolTip="{c:L tip.color}">
                                <Ellipse Width="12" Height="12" Fill="{DynamicResource Accent}"/>
                            </Button>
                            <Button x:Name="ThemeBtn" Style="{StaticResource FootButton}" Click="ThemeBtn_Click" ToolTip="{c:L tip.theme}">
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="ThemeIcon" Text="&#xE793;" Style="{StaticResource Icon}" Margin="0,0,6,0"/><TextBlock x:Name="ThemeLabel" Text="System" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <!-- Menus de idioma y color -->
                <Popup x:Name="LangPopup" PlacementTarget="{Binding ElementName=LangBtn}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                    <Border Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="210">
                        <StackPanel x:Name="LangList"/>
                    </Border>
                </Popup>
                <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorBtn}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                    <Border Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="190">
                        <StackPanel x:Name="ColorList"/>
                    </Border>
                </Popup>
            </Grid>

            <!-- ================= HOJA ================= -->
            <Border Grid.Column="1" Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="14" Margin="0,8,8,8">
                <Grid>
                    <!-- ======== LIMPIEZA ======== -->
                    <Grid x:Name="PageHome" Margin="36,34,36,28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Border Style="{StaticResource SegBox}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeQuick" Content="{c:L mode.quick}" Style="{StaticResource SegItem}" GroupName="mode" Checked="Mode_Checked"/>
                                        <RadioButton x:Name="ModeFull" Content="{c:L mode.full}" Style="{StaticResource SegItem}" GroupName="mode" Checked="Mode_Checked"/>
                                        <RadioButton x:Name="ModeTodo" Content="{c:L mode.todo}" Style="{StaticResource SegItem}" GroupName="mode" Checked="Mode_Checked"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="CleanBtn" Style="{StaticResource PrimaryButton}" Content="{c:L home.clean}" Click="CleanNow_Click"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{c:L home.title}" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="HomeSub" Style="{StaticResource Sub}" FontSize="14.5" Margin="0,4,0,0" Text="..."/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,24,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel><TextBlock x:Name="HomeDiskTotal" DockPanel.Dock="Right" Style="{StaticResource Meta}" Text="-"/><TextBlock Text="{c:L home.disk}" Style="{StaticResource H2}"/></DockPanel>
                                    <TextBlock Margin="0,8,0,0"><Run x:Name="HomeDiskFree" Text="-" FontSize="34" FontWeight="Bold" FontFamily="{StaticResource Display}"/><Run Text=" "/><Run Text="{c:L home.free}" FontSize="15" Foreground="{DynamicResource Muted}"/></TextBlock>
                                    <ProgressBar x:Name="HomeDiskBar" Maximum="1" Margin="0,12,0,8"/>
                                    <DockPanel><TextBlock x:Name="HomeDiskHint" DockPanel.Dock="Right" Style="{StaticResource Meta}" FontSize="12" Text=""/><TextBlock x:Name="HomeDiskUsed" Style="{StaticResource Meta}" FontSize="12" Text="-"/></DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="HomeBackupToggle" Style="{StaticResource Toggle}" Click="BackupToggle_Click">
                                        <TextBlock Text="{c:L home.backup}" Style="{StaticResource H2}"/>
                                    </CheckBox>
                                    <TextBlock x:Name="HomeBackupStatus" Style="{StaticResource Sub}" Margin="0,10,0,0" Text="-"/>
                                    <Button Style="{StaticResource LinkButton}" FontSize="13" Content="{c:L home.backupSettings}" Click="GoBackup_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel><TextBlock x:Name="HomeStepsMeta" DockPanel.Dock="Right" Style="{StaticResource Meta}" Text="-"/><TextBlock x:Name="HomeStepsTitle" Style="{StaticResource H2}" Text="-"/></DockPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                        <ItemsControl x:Name="HomeSteps">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel><TextBlock x:Name="HomeFreedMeta" DockPanel.Dock="Right" Style="{StaticResource Meta}" Text=""/><TextBlock Text="{c:L home.freed}" Style="{StaticResource H2}"/></DockPanel>
                                    <Canvas x:Name="HomeChart" Grid.Row="1" Margin="0,14,0,0" Background="Transparent" SizeChanged="HomeChart_SizeChanged"/>
                                    <TextBlock x:Name="HomeChartEmpty" Grid.Row="1" Text="{c:L hist.empty}" Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ======== PERSONALIZADA ======== -->
                    <Grid x:Name="PageCustom" Visibility="Collapsed" Margin="36,34,36,28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{c:L custom.title}" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Sub}" FontSize="14.5" Margin="0,4,0,16" Text="{c:L custom.sub}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Style="{StaticResource GhostButton}" Content="{c:L custom.asQuick}" Margin="0,0,8,0" Click="SelQuick_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="{c:L custom.asFull}" Margin="0,0,8,0" Click="SelFull_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="{c:L custom.all}" Margin="0,0,8,0" Click="SelAll_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="{c:L custom.none}" Click="SelNone_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer x:Name="CustomScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{c:L custom.system}" Style="{StaticResource Overline}"/>
                                <ItemsControl x:Name="CustomList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                <TextBlock Text="{c:L custom.cs2}" Style="{StaticResource Overline}" Margin="0,12,0,8"/>
                                <UniformGrid Columns="3">
                                    <CheckBox x:Name="CustomShader" Style="{StaticResource CheckCard}" Click="CustomItem_Click">
                                        <StackPanel><TextBlock Text="{c:L mod.shader}" FontWeight="SemiBold"/><TextBlock Text="{c:L mod.shader.d}" Style="{StaticResource Sub}" FontSize="12"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="CustomMouse" Style="{StaticResource CheckCard}" Click="CustomItem_Click">
                                        <StackPanel><TextBlock Text="{c:L mod.mouse}" FontWeight="SemiBold"/><TextBlock Text="{c:L mod.mouse.d}" Style="{StaticResource Sub}" FontSize="12"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="CustomNvidia" Style="{StaticResource CheckCard}" Click="CustomItem_Click">
                                        <StackPanel><TextBlock Text="{c:L mod.nvidia}" FontWeight="SemiBold"/><TextBlock Text="{c:L mod.nvidia.d}" Style="{StaticResource Sub}" FontSize="12"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="CustomPower" Style="{StaticResource CheckCard}" Click="CustomItem_Click">
                                        <StackPanel><TextBlock Text="{c:L mod.power}" FontWeight="SemiBold"/><TextBlock Text="{c:L mod.power.d}" Style="{StaticResource Sub}" FontSize="12"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="CustomNetwork" Style="{StaticResource CheckCard}" Click="CustomItem_Click">
                                        <StackPanel><TextBlock Text="{c:L mod.network}" FontWeight="SemiBold"/><TextBlock Text="{c:L mod.network.d}" Style="{StaticResource Sub}" FontSize="12"/></StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="CustomOem" Style="{StaticResource CheckCard}" Click="CustomItem_Click">
                                        <StackPanel><TextBlock Text="{c:L mod.oem}" FontWeight="SemiBold"/><TextBlock Text="{c:L mod.oem.d}" Style="{StaticResource Sub}" FontSize="12"/></StackPanel>
                                    </CheckBox>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,12" Margin="0,12,8,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{c:L custom.run}" Click="RunCustom_Click"/>
                                <TextBlock x:Name="CustomCount" VerticalAlignment="Center" Style="{StaticResource Meta}" Text="0"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ======== MODULOS CS2 ======== -->
                    <ScrollViewer x:Name="PageCs2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="36,34,36,28">
                            <TextBlock Text="{c:L cs2.title}" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Sub}" FontSize="14.5" Margin="0,4,0,22" Text="{c:L cs2.sub}"/>

                            <TextBlock Text="{c:L cs2.st.title}" Style="{StaticResource Overline}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="{c:L cs2.st.power}" Style="{StaticResource Meta}" FontSize="12"/><TextBlock x:Name="StPower" Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="…"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="{c:L cs2.st.mouse}" Style="{StaticResource Meta}" FontSize="12"/><TextBlock x:Name="StMouse" Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="…"/></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,16,0"><TextBlock Text="{c:L cs2.st.shader}" Style="{StaticResource Meta}" FontSize="12"/><TextBlock x:Name="StShader" Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="…"/></StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,16,0"><TextBlock Text="{c:L cs2.st.nvidia}" Style="{StaticResource Meta}" FontSize="12"/><TextBlock x:Name="StNvidia" Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="…"/></StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource Line2}" Margin="0,16"/>
                                    <DockPanel>
                                        <Button x:Name="UndoBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Click="Undo_Click" Content="{c:L cs2.undo.btn}"/>
                                        <StackPanel Margin="0,0,18,0"><TextBlock Text="{c:L cs2.undo.title}" Style="{StaticResource H2}"/><TextBlock x:Name="UndoSub" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="-"/></StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{c:L cs2.mods}" Style="{StaticResource Overline}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{c:L cs2.shader.btn}" Click="Shader_Click" VerticalAlignment="Top"/>
                                        <StackPanel Margin="0,0,18,0"><TextBlock Text="{c:L mod.shader}" Style="{StaticResource H2}"/><TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{c:L cs2.shader.sub}"/></StackPanel>
                                    </DockPanel>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="ShaderPathBox" LostFocus="ShaderPath_LostFocus"/>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ShaderBrowse_Click" ToolTip="{c:L cs2.browse}"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/></Button>
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ShaderDefault_Click" Content="{c:L cs2.detect}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="Mouse_Click" Content="{c:L cs2.mouse.btn}"/>
                                    <StackPanel Margin="0,0,18,0"><TextBlock Text="{c:L mod.mouse}" Style="{StaticResource H2}"/><TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{c:L cs2.mouse.sub}"/></StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OpenInspector_Click" Content="{c:L cs2.nv.open}"/>
                                        <Button x:Name="NvidiaBtn" Style="{StaticResource PrimaryButton}" Click="Nvidia_Click" Content="{c:L cs2.nv.btn}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,0"><TextBlock Text="{c:L mod.nvidia}" Style="{StaticResource H2}"/><TextBlock x:Name="NvidiaSub" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{c:L cs2.nv.sub}"/></StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="Power_Click" Content="{c:L cs2.pw.btn}"/>
                                    <StackPanel Margin="0,0,18,0"><TextBlock Text="{c:L mod.power}" Style="{StaticResource H2}"/><TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{c:L cs2.pw.sub}"/></StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Click="ShortcutNoBackup_Click" Content="{c:L sc.nobackup}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,0"><TextBlock Text="{c:L sc.title}" Style="{StaticResource H2}"/><TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{c:L sc.sub}"/></StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======== VIDEO CS2 (cs2_video.txt) ======== -->
                    <ScrollViewer x:Name="PageVideo" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="36,34,36,28">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Border x:Name="VidAccountsBox" Style="{StaticResource SegBox}" Margin="0,0,8,0"><StackPanel x:Name="VidAccounts" Orientation="Horizontal"/></Border>
                                    <Button Style="{StaticResource GhostButton}" Click="VidRefresh_Click" Content="{c:L sv.refresh}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0"><TextBlock Text="{c:L vid.title}" Style="{StaticResource H1}"/><TextBlock Style="{StaticResource Sub}" FontSize="14.5" Margin="0,4,0,0" Text="{c:L vid.sub}"/></StackPanel>
                            </DockPanel>
