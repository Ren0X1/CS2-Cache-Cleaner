# Archivos que Windows necesita con CRLF
# .reg exportados por Windows son UTF-16: git NO debe tocar sus saltos de linea
*.reg -text
*.iss text eol=crlf
*.cs  text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf

# Binarios
*.exe binary
*.ico binary
*.png binary
*.nip binary

# Script de AtlasOS (polyglot batch/PowerShell): se guarda byte a byte, tal cual funciona
src/RnxCleaner/Assets/fixStoreIssues.cmd -text

# Config de CS2 de RNX: se guarda byte a byte
src/RnxCleaner/Assets/cs2config/** -text

# Fuente RNX y plantilla fonts.conf: byte a byte
src/RnxCleaner/Assets/fonts/** -text
